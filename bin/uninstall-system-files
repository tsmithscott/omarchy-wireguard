#!/bin/bash
# Removes everything the WireGuard plugin ever installed outside your home
# directory, and nothing else: a file at one of those paths that the plugin
# cannot verify it installed (see system-files.bash) is left in place.
# Run this BEFORE `omarchy plugin remove tsmithscott.wireguard` (or any
# time), through pkexec:
#
#   pkexec ~/.config/omarchy/plugins/tsmithscott.wireguard/bin/uninstall-system-files
#
# NetworkManager profiles you imported are yours and are left alone; delete
# them in the panel first, or with `nmcli connection delete <name>`.

set -euo pipefail
export PATH=/usr/bin:/usr/sbin
source -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/system-files.bash"

wg_plugin_remove "$WG_PLUGIN_HOOK" "$WG_PLUGIN_HELPER" "$WG_PLUGIN_RULE"
