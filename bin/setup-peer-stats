#!/bin/bash
# Optional: lets the WireGuard plugin show live peer stats (last handshake,
# per-peer traffic, current endpoint), which the kernel only reveals to root.
#
# Installs two root-owned files:
#   /usr/local/bin/omarchy-wg-dump     prints `wg show all dump` with every
#                                      private and preshared key replaced
#   /etc/sudoers.d/omarchy-wg-dump     lets <user> run exactly that helper,
#                                      with no arguments, without a password
#
# Run through pkexec:  pkexec setup-peer-stats <user>
# Undo:                pkexec setup-peer-stats --remove

set -euo pipefail

helper=/usr/local/bin/omarchy-wg-dump
rule=/etc/sudoers.d/omarchy-wg-dump
user=${1:?usage: setup-peer-stats <user> | --remove}

if [[ $user == --remove ]]; then
  rm -f -- "$helper" "$rule"
  echo "Removed $helper and $rule"
  exit 0
fi

[[ $user =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] || { echo "Invalid user name" >&2; exit 2; }
id -- "$user" >/dev/null

tmp=$(mktemp)
trap 'rm -f -- "$tmp"' EXIT

cat >"$tmp" <<'HELPER'
#!/bin/bash
# Read-only WireGuard runtime stats for the Omarchy WireGuard plugin.
# Interface lines lose their private key, peer lines their preshared key.
set -euo pipefail
/usr/bin/wg show all dump | /usr/bin/awk 'BEGIN { FS = OFS = "\t" } NF == 5 { $2 = "(hidden)" } NF == 9 { $3 = "(hidden)" } { print }'
HELPER
install -d -m 755 /usr/local/bin
install -o root -g root -m 755 "$tmp" "$helper"

printf '%s ALL=(root) NOPASSWD: %s ""\nDefaults!%s !log_allowed\n' "$user" "$helper" "$helper" >"$tmp"
visudo -cqf "$tmp"
install -o root -g root -m 440 "$tmp" "$rule"

echo "Installed $helper and $rule for $user"

