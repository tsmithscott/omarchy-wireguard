#!/bin/bash
# Status snapshot for the WireGuard bar plugin. Runs as the logged-in user and
# never asks for a password. Prints one tab-separated record per line:
#
#   I  <ifname> <rx_bytes> <tx_bytes> <mtu> <addr,addr,...>   every mode
#   C  <nmcli terse line: NAME:UUID:TYPE:DEVICE:STATE:FILENAME:AUTOCONNECT>   full
#   N  <uuid> <field> <value>                                  full (NM config)
#   D  <wg show all dump line, keys redacted>                  full, if enabled
#   S  ok|fail|absent                                          full (peer stats)
#   R  <ifname> <dns servers in use, space-separated>          full
#   Q  <ifname> <dns domains in use, space-separated>          full
#   G  <global-dns: yes|no> <tunnel-dns dispatcher: yes|no|foreign> <hook version>  full
#
# Usage: wg-status [fast|full] [stats]

set -u
source -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/system-files.bash"
mode=${1:-fast}
want_stats=${2:-}
tab=$'\t'

for dir in /sys/class/net/*; do
  [[ -r $dir/uevent ]] || continue
  grep -qx 'DEVTYPE=wireguard' "$dir/uevent" 2>/dev/null || continue
  ifname=${dir##*/}
  rx=$(<"$dir/statistics/rx_bytes")
  tx=$(<"$dir/statistics/tx_bytes")
  mtu=$(<"$dir/mtu")
  addrs=$(ip -o addr show dev "$ifname" 2>/dev/null | awk '{print $4}' | paste -sd, -)
  printf 'I\t%s\t%s\t%s\t%s\t%s\n' "$ifname" "$rx" "$tx" "$mtu" "$addrs"
done

[[ $mode == full ]] || exit 0

# What systemd-resolved is actually using on each tunnel ("Link 9 (wg0): a b").
for dir in /sys/class/net/*; do
  grep -qx 'DEVTYPE=wireguard' "$dir/uevent" 2>/dev/null || continue
  ifname=${dir##*/}
  in_use=$(resolvectl dns "$ifname" 2>/dev/null | sed -n 's/^Link [0-9]* ([^)]*):[[:space:]]*//p' | head -1)
  printf 'R\t%s\t%s\n' "$ifname" "$in_use"
  domains=$(resolvectl domain "$ifname" 2>/dev/null | sed -n 's/^Link [0-9]* ([^)]*):[[:space:]]*//p' | head -1)
  printf 'Q\t%s\t%s\n' "$ifname" "$domains"
done

# A NetworkManager [global-dns] block (omarchy dns writes one) makes NM ignore
# per-connection DNS; the dispatcher script puts tunnel DNS back.
global=no
grep -qs '^[[:space:]]*\[global-dns' /etc/NetworkManager/NetworkManager.conf /etc/NetworkManager/conf.d/*.conf && global=yes
# "foreign": something else (an administrator's own script) is at the hook's
# path; the plugin leaves it alone and stops offering to install or update.
dispatcher=no hook_version=0
hook=$WG_PLUGIN_HOOK
case $(wg_plugin_file_state "$hook") in
  ours)
    if [[ -x $hook ]]; then
      dispatcher=yes hook_version=1
      v=$(sed -n 's/^# hook-version: \([0-9]\{1,4\}\)$/\1/p' "$hook" 2>/dev/null | head -1)
      [[ -n $v ]] && hook_version=$v
    fi ;;
  foreign) dispatcher=foreign ;;
esac
printf 'G\t%s\t%s\t%s\n' "$global" "$dispatcher" "$hook_version"

nm_fields=wireguard.peers,wireguard.listen-port,ipv4.addresses,ipv6.addresses,ipv4.dns,ipv6.dns
nm_fields+=,ipv4.dns-priority,ipv6.dns-priority,ipv4.dns-search,ipv6.dns-search
nm_fields+=,ipv4.never-default,ipv6.never-default,ipv4.routes,ipv6.routes,ipv4.method,ipv6.method

if command -v nmcli >/dev/null 2>&1; then
  while IFS= read -r line; do
    printf 'C\t%s\n' "$line"
    # UUID is the second terse field; UUIDs never contain escaped colons.
    rest=${line#*[!\\]:}
    uuid=${rest%%:*}
    [[ $uuid =~ ^[0-9a-fA-F-]{36}$ ]] || continue
    # Volatile (/run) profiles belong to whatever created the interface
    # (wg-quick, NetBird, ...); their config is not ours to read.
    [[ $line == *:/run/* ]] && continue
    # One nmcli call per profile: terse "field:value" lines, values escaped
    # the same way `nmcli -g` escapes them.
    while IFS= read -r prop; do
      [[ $prop == *:* ]] || continue
      printf 'N\t%s\t%s\t%s\n' "$uuid" "${prop%%:*}" "${prop#*:}"
    done < <(nmcli -t -f "$nm_fields" connection show uuid "$uuid" 2>/dev/null)
  done < <(nmcli -t -f NAME,UUID,TYPE,DEVICE,STATE,FILENAME,AUTOCONNECT connection show 2>/dev/null | grep -E '^([^:]|\\:)*:[0-9a-fA-F-]{36}:wireguard:')
fi

if [[ $want_stats == stats ]]; then
  helper=$WG_PLUGIN_HELPER
  if [[ -x $helper ]]; then
    if out=$(sudo -n "$helper" 2>/dev/null); then
      [[ -n $out ]] && printf '%s\n' "$out" | sed "s/^/D${tab}/"
      echo "S${tab}ok"
    else
      echo "S${tab}fail"
    fi
  else
    echo "S${tab}absent"
  fi
fi
